# -----------------------------------------------------------------
# Chatbot microservice configuration (Python / FastAPI)
# -----------------------------------------------------------------

# Port this microservice runs on
PORT=5200

# Paste your Gemini API key here (get one free at https://aistudio.google.com/apikey)
# The chatbot's FAQ feature will not work until this is filled in.
GEMINI_API_KEY=AQ.Ab8RN6KWwzQCnG46yw8hdazzPHUMQacSXR-K9Lvwhkpf_axfPw

# Which Gemini model to use
# (gemini-1.5-flash was retired by Google - gemini-2.5-flash is the
# current supported model as of mid/late 2026)
GEMINI_MODEL=gemini-3.5-flash

# The main Spring Boot backend, used to fetch live slot availability & rates
MAIN_BACKEND_URL=http://localhost:8080

# The .NET logging microservice, used to record every chatbot question asked
LOGGING_SERVICE_URL=http://localhost:5100/api/logs

# -----------------------------------------------------------------
# This microservice's OWN MySQL database (separate from smart_parking_db
# and separate from logging_db). It only stores chat history.
# -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sql123
DB_NAME=chatbot_db
